# Public values only — these end up in the app binary. Secrets go in supabase/.env.local.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_replace_me
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EAS_PROJECT_ID=
# Local only: set to false to build for the simulator without an Apple Developer signing team.
GLOVEBOX_APPLE_SIGN_IN=false
